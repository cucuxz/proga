{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Собрать практику 3",
      "type": "process",
      "command": "dotnet",
      "osx": {
        "command": "${env:HOME}/учеба/proga 2 sem/.dotnet/dotnet"
      },
      "args": [
        "build", "${workspaceFolder}/CollectionsPractice.csproj", "-c", "Debug",
        "--disable-build-servers", "-p:UseSharedCompilation=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1" }
      },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
